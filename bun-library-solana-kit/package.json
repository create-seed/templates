{
  "bin": {
    "bun-library-solana-kit": "dist/cli.mjs"
  },
  "create-seed": {
    "instructions": [
      "Create a GitHub repository for this project:",
      "+gh repo create",
      "~",
      "Install these GitHub Apps on your new repo:",
      "- Changeset Bot: https://github.com/apps/changeset-bot/installations/select_target",
      "- pkg.pr.new: https://github.com/apps/pkg-pr-new/installations/select_target",
      "~",
      "Enable GitHub Actions to create and approve pull requests:",
      "Open your repository settings:",
      "+gh browse --settings",
      "In GitHub, go to Actions -> General.",
      "Under Workflow permissions, enable Allow GitHub Actions to create and approve pull requests.",
      "If the checkbox is disabled, enable it in your organization Actions settings first.",
      "~",
      "Publish the first release manually to set up npm trusted publishing:",
      "Set the package name in package.json first.",
      "Build the package:",
      "+{pm} run build",
      "Publish it once with npm:",
      "+npm publish --access public",
      "Then connect the package to .github/workflows/publish.yaml in npm package settings."
    ]
  },
  "dependencies": {
    "@solana/kit": "6.8.0",
    "@solana/kit-plugin-rpc": "0.9.0"
  },
  "devDependencies": {
    "@beeman/testcontainers": "1.1.1",
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "2.30.0",
    "@intellectronica/ruler": "0.3.38",
    "@solana/kit-plugins": "0.9.0",
    "@types/bun": "1.3.11",
    "pkg-pr-new": "0.0.62",
    "publint": "0.3.18",
    "testcontainers": "11.11.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "description": "TypeScript library for Solana development with @solana/kit, Surfpool e2e tests, Bun, tsdown, Biome, and Changesets",
  "name": "bun-library-solana-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeman/bun-library-solana-kit.git"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check-types": "tsc -b --noEmit",
    "ci": "bun run build && bun run lint && bun run check-types && bun run test",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --error-on-warnings --write",
    "release": "changeset publish",
    "ruler:apply": "ruler apply --local-only",
    "test": "bun test test/*.test.ts",
    "test:e2e": "bun test test/e2e.test.ts",
    "test:watch": "bun test test/*.test.ts --watch",
    "version": "changeset version && bun lint:fix"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "0.0.0"
}
