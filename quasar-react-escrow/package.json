{
  "name": "quasar-react-escrow",
  "description": "React app with Vite, TypeScript, Tailwind CSS v4, wallet-ui, Solana Kit, and a Quasar escrow program",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check-types": "tsc -b --noEmit",
    "ci": "bun run --sequential quasar:build build check-types lint",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postquasar:build": "rm -v program/client/typescript/*/web3.ts program/client/typescript/*/package.json",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "quasar": "cd program && quasar",
    "quasar:deploy": "bun run quasar deploy",
    "quasar:build": "bun run quasar build",
    "setup": "bun quasar keys new && bun run quasar:build",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.4.0",
    "@blueshift-gg/quasar-svm": "0.1.12",
    "@fontsource-variable/roboto": "5.2.10",
    "@solana/codecs": "6.0.0",
    "@solana-mobile/wallet-standard-mobile": "0.5.1",
    "@solana-program/memo": "0.11.0",
    "@solana/kit": "6.8.0",
    "@solana/react": "3.0.3",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "5.99.0",
    "@wallet-ui/react": "4.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-error-boundary": "6.1.1",
    "react-router": "7.14.1",
    "shadcn": "4.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@eslint/json": "1.2.0",
    "@tanstack/eslint-plugin-query": "5.99.0",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-perfectionist": "5.8.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "16.5.0",
    "lefthook": "2.1.5",
    "prettier": "3.8.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "7.3.2",
    "vitest": "4.1.4"
  },
  "create-seed": {
    "instructions": [
      "Build the program and generated client:",
      "+bun quasar build",
      "Deploy the program:",
      "+bun quasar deploy",
      "Start the web UI:",
      "+bun dev"
    ],
    "tools": {
      "quasar": {
        "docsUrl": "https://quasar-lang.com/docs/getting-started/installation",
        "minVersion": "0.0.0"
      },
      "rustc": {
        "docsUrl": "https://rustup.rs",
        "minVersion": "1.94.0"
      },
      "solana": {
        "docsUrl": "https://docs.anza.xyz/cli/install",
        "minVersion": "3.0.0"
      }
    }
  }
}
