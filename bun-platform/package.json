{
  "name": "bun-platform",
  "private": true,
  "description": "Bun platform template with TanStack Start, Hono, oRPC, Better Auth, Drizzle, and shared UI packages",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@libsql/client": "0.15.15",
      "@orpc/client": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/server": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "@polar-sh/better-auth": "^1.6.4",
      "@types/bun": "1.3.13",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "ai": "^6.0.156",
      "better-auth": "1.5.2",
      "dotenv": "^17.4.1",
      "drizzle-orm": "^0.45.2",
      "hono": "^4.12.12",
      "libsql": "0.5.22",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "sonner": "^2.0.5",
      "tailwindcss": "^4.1.18",
      "zod": "^4.1.13"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "ci": "bun run lint && turbo run build check-types test test:e2e test:integration",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:local": "bun run --cwd packages/db db:local",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:reset": "rm packages/db/local.db*",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:studio": "bun run --cwd packages/db db:studio",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:local": "bun run ./scripts/dev-local.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "lefthook install",
    "setup": "bun run ./scripts/setup.ts",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration"
  },
  "dependencies": {
    "@bun-platform/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bun-platform/config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint-plugin-perfectionist": "^5.8.0",
    "lefthook": "^2.1.5",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.59.0",
    "turbo": "^2.9.5",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "create-seed": {
    "instructions": [
      "Set up the local database:",
      "+{pm} run db:local",
      "Apply the schema once:",
      "+{pm} run db:push",
      "Seed the sample data:",
      "+{pm} run db:seed",
      "~",
      "Your database is ready. Start the app:",
      "+{pm} run dev:api",
      "+{pm} run dev:web",
      "~",
      "Open http://localhost:3001 and sign in with alice@example.com / password123"
    ]
  }
}
